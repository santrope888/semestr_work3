{
  "info": {
    "_postman_id": "66936e54-12ef-4ba1-9460-b9a2fa1ebdf6",
    "name": "Aura Motum — REST API",
    "description": "Коллекция запросов для тестирования REST API проекта Aura Motum.\n\n**Аутентификация:**\n- REST API использует HTTP Basic Auth — настроена на уровне коллекции.\n- По умолчанию используются креды admin/admin (через переменные коллекции).\n- Чтобы тестировать как user — поменяйте переменные username/password в Variables коллекции на user/user.\n\n**Учётные данные** (создаются миграцией V17):\n- admin / admin (роль ADMIN)\n- user  / user  (роль USER)\n\n**MVC endpoints** (/login, /register) защищены CSRF и тестируются через браузер, а не через эту коллекцию.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "host",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "password",
      "value": "admin",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "MVC ENDPOINTS (для справки)",
      "item": [
        {
          "name": "Register new user (MVC form)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": {
              "raw": "{{host}}/register",
              "host": [
                "{{host}}"
              ],
              "path": [
                "register"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "username",
                  "value": "testuser",
                  "type": "text"
                },
                {
                  "key": "email",
                  "value": "test@mail.ru",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "password123",
                  "type": "text"
                },
                {
                  "key": "phoneNumber",
                  "value": "+79991234567",
                  "type": "text"
                }
              ]
            }
          },
          "response": []
        }
      ],
      "description": "MVC формы защищены CSRF и тестируются через браузер. Эти запросы оставлены только для справки."
    },
